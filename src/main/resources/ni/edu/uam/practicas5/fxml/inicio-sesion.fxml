<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.practicas5.controller.InicioSesionController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label text="Inicio de Sesion">
      <font>
         <Font name="System Bold Italic" size="21.0" />
      </font>
   </Label>

    <Label fx:id="welcomeText" text="Usuario">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Label>
   <TextField fx:id="txtUsuario" />
   <Label text="Contraseña">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Label>
   <PasswordField fx:id="pwdContrasena" />
   <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
      <children>
         <Button fx:id="btnIngresar" mnemonicParsing="false" onAction="#iniciarSesion" text="Ingresar" />
         <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#salir" text="Salir" />
      </children>
   </HBox>
</VBox>
